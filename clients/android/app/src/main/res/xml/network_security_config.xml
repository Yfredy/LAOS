<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 个人侧载客户端：唯一浏览目标就是自家 laosweb（局域网 http，无 TLS）。
         预编译 APK 无法预知用户电脑 IP，单 IP 白名单会挡住连接——这里放行
         明文 http 全域。若你在意（例如手机上有其他敏感流量），改用源码
         自建：把本文件换回单 IP 白名单（见 README 路线 B）。 -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
