<?xml version="1.0" encoding="UTF-8"?>
<!-- laos · evolve.run RSI 治理驱动交接结构图（2026-10-09）
     打开方式：draw.io desktop 直接打开本文件；或用 diagrams.net 网页版导入。
     分层：进化循环外（laos 核心）/ drivers 装配面 / 进化循环内（venv 子进程）。
     证据锚点见 docs/guide/rsi-evolve-handover.md L0 表与 docs/diagrams/rsi-evolve-architecture.architecture.json -->
<mxfile host="drawio" version="26.0.0">
  <diagram name="rsi-evolve-handover" id="rsi-evolve-1">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="laos · evolve.run — RSI 负载的治理驱动架构（治理在循环外，进化在循环内）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="820" height="30" as="geometry" />
        </mxCell>
        <mxCell id="agent" value="研究 Agent&#xa;evolve.run 调用方（caps: evolve.*）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="120" y="40" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="R1" value="进化循环外 —— laos 核心治理（纯 stdlib，不被进化的 agent 触碰）" style="rounded=0;whiteSpace=wrap;html=1;container=1;pointerEvents=0;verticalAlign=top;fontStyle=1;fillColor=#eef4fb;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="760" height="550" as="geometry" />
        </mxCell>
        <mxCell id="kernel" value="syscall 网关&#xa;caps→task_scope→validate→EDQUOT→sentinel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="R1">
          <mxGeometry x="80" y="30" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sentinel" value="sentinel 风险闸&#xa;六级判定序（always_ask 待 followups T1）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="R1">
          <mxGeometry x="460" y="30" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dispatch" value="阻塞派发 _BLOCKING_BUILTINS&#xa;asyncio.to_thread（不卡事件循环）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="R1">
          <mxGeometry x="80" y="170" width="240" height="70" as="geometry" />
