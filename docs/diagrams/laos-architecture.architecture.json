  "cards": [
    {
      "dot": "cyan",
      "title": "定位叙事（红线）",
      "items": [
        "基座是 Linux 内核；Agent 是新负载（与进程同类）",
        "laos 是内核治理在用户态的延伸——不是「给 AI Agent 装上操作系统」"
      ]
    },
    {
      "dot": "emerald",
      "title": "听觉闭环",
      "items": [
        "drv_mic 的 VAD/唤醒事件进入对话管线入口（wakegate 只认 KWS，ASR 文本永不唤醒）",
        "KWS 实测（zipformer 3.3M int8）：解码中位 7.56ms，唤醒词零误报"
      ]
    },
    {
      "dot": "rose",
      "title": "隐私红线",
      "items": [
        "录音只由显式 syscall 触发；LAOS_REC=0 全局禁录；ASR 全本地",
        "记忆与审计全落本地文件（右下安全组内），不出发本机"
      ]
    },
    {
      "dot": "amber",
      "title": "零依赖承诺",
      "items": [
        "laos/ 核心纯 stdlib（946 项测试守护）",
        "重依赖（sherpa-onnx / clef-flash / torch）只进驱动子进程域，经 MCP 挂接"
      ]
    }
  ]
