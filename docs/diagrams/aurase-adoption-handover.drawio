          <mxGeometry x="80" y="40" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="aggregate" value="aggregate()（evolve.py:170）&#xa;集内 min-max + 翻转 + 加权和 → [0,1]&#xa;无区分度指标 = 中性满分 1.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="A1">
          <mxGeometry x="440" y="40" width="280" height="80" as="geometry" />
