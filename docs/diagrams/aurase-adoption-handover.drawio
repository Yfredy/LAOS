<?xml version="1.0" encoding="UTF-8"?>
<!-- laos · AuraSE 取长补短落地交接结构图（2026-10-09）
     打开方式：draw.io desktop 直接打开本文件；或用 diagrams.net 网页版导入（本机无 CLI，浏览器路径为主）。
     分层：奖励治理面（laos 核心）/ drivers 立约与组装 / 复现区（决策面规则版）/ 论文与调研证据源。
     证据锚点见 docs/guide/aurase-adoption-handover.md L0 表与 docs/diagrams/aurase-adoption-architecture.architecture.json -->
<mxfile host="drawio" version="26.0.0">
  <diagram name="aurase-adoption-handover" id="aurase-adoption-1">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1160" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
